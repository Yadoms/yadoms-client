{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome against localhost",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/apps/yadoms-cs",
      "sourceMaps": true,
      "pathMapping": {
        "/@fs/C:/projects/domotique/yadoms/yadoms-client/": "${workspaceFolder}/"
      },
      "sourceMapPathOverrides": {
        "http://localhost:4200/@fs/*": "*",
        "/@fs/*": "*"
      }
    },
    {
      "name": "Debug yadoms-cs",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/nx",
      "args": ["serve", "yadoms-cs"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
